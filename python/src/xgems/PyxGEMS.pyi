from __future__ import annotations

from typing import Dict, List, Optional, overload

import numpy as np

# ---------------------------------------------------------------------------
# Free functions
# ---------------------------------------------------------------------------

def update_loggers(use_cout: bool, logfile_name: str, log_level: int) -> None: ...
def parse_chemical_formula(formula: str) -> Dict[str, float]: ...

# ---------------------------------------------------------------------------
# ChemicalEngineOptions
# ---------------------------------------------------------------------------

class ChemicalEngineOptions:
    warmstart: bool
    print_zero_amounts: bool
    def __init__(self) -> None: ...

# ---------------------------------------------------------------------------
# ChemicalEngine
# ---------------------------------------------------------------------------

class ChemicalEngine:
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, filename: str) -> None: ...
