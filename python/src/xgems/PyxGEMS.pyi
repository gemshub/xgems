        self, dch_json: str, ipm_json: str, dbr_json: str
    ) -> None: ...
    def readDbrFromFile(self, filename: str) -> None: ...
    def readDbrFromJsonString(self, dbr_json: str) -> None: ...
    def writeDbrToFile(self, filename: str) -> None: ...
    def writeDbrToJsonString(self) -> str: ...

    # System dimensions
    def numElements(self) -> int: ...
    def numSpecies(self) -> int: ...
    def numPhases(self) -> int: ...
    @overload
    def numSpeciesInPhase(self, iphase: int) -> int: ...
    @overload
    def numSpeciesInPhase(self, phase: str) -> int: ...
    def numSpeciesInPhase_i(self, iphase: int) -> int: ...

    # Names
    def elementName(self, index: int) -> str: ...
    def elementName_i(self, index: int) -> str: ...
    def speciesName(self, index: int) -> str: ...
    def speciesName_i(self, index: int) -> str: ...
    def phaseName(self, index: int) -> str: ...
    def phaseName_i(self, index: int) -> str: ...

    # Species charge
    @overload
    def speciesCharge(self, index: int) -> float: ...
    @overload
    def speciesCharge(self, species: str, phase: Optional[str] = ...) -> float: ...
    def speciesCharge_i(self, index: int) -> float: ...

    # Index lookups
    def indexElement(self, name: str) -> int: ...
    def indexSpecies(self, name: str, phase: Optional[str] = ...) -> int: ...
    def indexSpeciesAll(self, name: str) -> List[int]: ...
    def indexSpeciesMap(self, name: str) -> Dict[str, int]: ...
    def indexPhase(self, name: str) -> int: ...
    def indexPhaseAll(self, name: str) -> List[int]: ...
    def indexPhaseWithSpecies(self, species_index: int) -> int: ...
    @overload
    def indexFirstSpeciesInPhase(self, iphase: int) -> int: ...
    @overload
    def indexFirstSpeciesInPhase(self, phase: str) -> int: ...
    def indexFirstSpeciesInPhase_i(self, iphase: int) -> int: ...

    # Matrices / vectors
    def elementMolarMasses(self) -> np.ndarray: ...
    def speciesMolarMasses(self) -> np.ndarray: ...
    def formulaMatrix(self) -> np.ndarray: ...

    # Options
    @property
    def options(self) -> ChemicalEngineOptions: ...
    @options.setter
    def options(self, value: ChemicalEngineOptions) -> None: ...
    def setWarmStart(self) -> None: ...
    def setColdStart(self) -> None: ...

    # Species limits / amounts
    @overload
    def setSpeciesUpperLimit(
        self, name: str, limit: float, phase: Optional[str] = ...
    ) -> None: ...
    @overload
    def setSpeciesUpperLimit(self, index: int, limit: float) -> None: ...
    def setSpeciesUpperLimit_i(self, index: int, limit: float) -> None: ...
    @overload
    def setSpeciesLowerLimit(
        self, name: str, limit: float, phase: Optional[str] = ...
    ) -> None: ...
    @overload
    def setSpeciesLowerLimit(self, index: int, limit: float) -> None: ...
    def setSpeciesLowerLimit_i(self, index: int, limit: float) -> None: ...
    @overload
    def setSpeciesAmount(
        self, name: str, amount: float, phase: Optional[str] = ...
    ) -> None: ...
    @overload
    def setSpeciesAmount(self, ispecies: int, amount: float) -> None: ...
    def setSpeciesAmount_i(self, ispecies: int, amount: float) -> None: ...

    # Standard Gibbs energy
    @overload
    def setStandardMolarGibbsEnergy(
        self, name: str, value: float, phase: Optional[str] = ...
    ) -> None: ...
    @overload
    def setStandardMolarGibbsEnergy(self, ispecies: int, value: float) -> None: ...
    def setStandardMolarGibbsEnergy_i(self, ispecies: int, value: float) -> None: ...

    # State setters
    def setPT(self, temperature: float, pressure: float) -> bool: ...
    def setB(self, composition: List[float]) -> None: ...

    # Equilibration
    @overload
    def reequilibrate(self) -> int: ...
    @overload
    def reequilibrate(self, warmstart: bool) -> int: ...
    def equilibrate(self, T: float, P: float, b: np.ndarray) -> int: ...

    # Convergence / diagnostics
    def converged(self) -> bool: ...
    def numIterations(self) -> int: ...
    def elapsedTime(self) -> float: ...

    # Scalar state
    def temperature(self) -> float: ...
    def pressure(self) -> float: ...
    def ionicStrength(self) -> float: ...
    def pH(self) -> float: ...
    def pe(self) -> float: ...
    def Eh(self) -> float: ...
    def systemMass(self) -> float: ...
    def systemVolume(self) -> float: ...
    def systemGibbsEnergy(self) -> float: ...
    def systemEnthalpy(self) -> float: ...
    def systemEntropy(self) -> float: ...
    def systemHeatCapacityConstP(self) -> float: ...
    def aqueousPhaseName(self) -> str: ...
    def gasPhaseName(self) -> str: ...

    # Element amounts
    def elementAmounts(self) -> np.ndarray: ...
    @overload
    def elementAmountsInPhase(self, iphase: int) -> np.ndarray: ...
    @overload
    def elementAmountsInPhase(self, phase: str) -> np.ndarray: ...
    def elementAmountsInPhase_i(self, iphase: int) -> np.ndarray: ...
    def elementAmountsInSpecies(self, species_index: int) -> np.ndarray: ...

    # Species amounts / bulk vectors
    @overload
    def speciesAmount(self, ispecies: int) -> float: ...
    @overload
    def speciesAmount(self, name: str, phase: Optional[str] = ...) -> float: ...
    def speciesAmount_i(self, ispecies: int) -> float: ...
    def setSpeciesAmounts(self, amounts: List[float]) -> None: ...
    def speciesAmounts(self) -> np.ndarray: ...
    def setSpeciesUpperLimits(self, limits: List[float]) -> None: ...
    def setSpeciesLowerLimits(self, limits: List[float]) -> None: ...
    def speciesUpperLimits(self) -> np.ndarray: ...
    def speciesLowerLimits(self) -> np.ndarray: ...

    # Species thermodynamic properties
    def moleFractions(self) -> np.ndarray: ...
    def speciesMolalities(self) -> np.ndarray: ...
    def lnActivityCoefficients(self) -> np.ndarray: ...
    def lnActivities(self) -> np.ndarray: ...
    def lnConcentrations(self) -> np.ndarray: ...
    def chemicalPotentials(self) -> np.ndarray: ...
    @overload
    def standardMolarGibbsEnergy(self, ispecies: int) -> float: ...
    @overload
    def standardMolarGibbsEnergy(
        self, species: str, phase: Optional[str] = ...
    ) -> float: ...
    def standardMolarGibbsEnergy_i(self, ispecies: int) -> float: ...
    @overload
    def standardMolarEnthalpy(self, ispecies: int) -> float: ...
    @overload
    def standardMolarEnthalpy(
        self, species: str, phase: Optional[str] = ...
    ) -> float: ...
    def standardMolarEnthalpy_i(self, ispecies: int) -> float: ...
    @overload
    def standardMolarVolume(self, ispecies: int) -> float: ...
    @overload
    def standardMolarVolume(
        self, species: str, phase: Optional[str] = ...
    ) -> float: ...
    def standardMolarVolume_i(self, ispecies: int) -> float: ...
    @overload
    def standardMolarEntropy(self, ispecies: int) -> float: ...
    @overload
    def standardMolarEntropy(
        self, species: str, phase: Optional[str] = ...
    ) -> float: ...
    def standardMolarEntropy_i(self, ispecies: int) -> float: ...
    @overload
    def standardMolarHeatCapacityConstP(self, ispecies: int) -> float: ...
    @overload
    def standardMolarHeatCapacityConstP(
        self, species: str, phase: Optional[str] = ...
    ) -> float: ...
    def standardMolarHeatCapacityConstP_i(self, ispecies: int) -> float: ...

    # Phase molar properties
    @overload
    def phaseMolarGibbsEnergy(self, iphase: int) -> float: ...
    @overload
    def phaseMolarGibbsEnergy(self, phase: str) -> float: ...
    def phaseMolarGibbsEnergy_i(self, iphase: int) -> float: ...
    @overload
    def phaseMolarEnthalpy(self, iphase: int) -> float: ...
    @overload
    def phaseMolarEnthalpy(self, phase: str) -> float: ...
    def phaseMolarEnthalpy_i(self, iphase: int) -> float: ...
    @overload
    def phaseMolarVolume(self, iphase: int) -> float: ...
    @overload
    def phaseMolarVolume(self, phase: str) -> float: ...
    def phaseMolarVolume_i(self, iphase: int) -> float: ...
    @overload
    def phaseMolarEntropy(self, iphase: int) -> float: ...
    @overload
    def phaseMolarEntropy(self, phase: str) -> float: ...
    def phaseMolarEntropy_i(self, iphase: int) -> float: ...
    @overload
    def phaseMolarHeatCapacityConstP(self, iphase: int) -> float: ...
    @overload
    def phaseMolarHeatCapacityConstP(self, phase: str) -> float: ...
    def phaseMolarHeatCapacityConstP_i(self, iphase: int) -> float: ...

    # Phase specific properties
